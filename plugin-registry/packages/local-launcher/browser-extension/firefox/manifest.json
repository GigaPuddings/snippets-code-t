{
  "manifest_version": 3,
  "name": "Snippets Code Bookmark Bridge",
  "version": "1.0.0",
  "description": "Connect one browser profile to Snippets Code for explicitly confirmed bookmark deletion.",
  "permissions": [
    "bookmarks",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "policy.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-bridge@snippets-code.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}

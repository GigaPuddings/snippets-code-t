{
  "manifest_version": 3,
  "name": "Snippets Code Bookmark Bridge",
  "version": "1.0.0",
  "description": "Connect one browser profile to Snippets Code for explicitly confirmed bookmark deletion.",
  "permissions": [
    "bookmarks",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}

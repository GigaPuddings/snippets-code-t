{
  "schemaVersion": 1,
  "id": "local-launcher",
  "version": "2.0.32",
  "kind": "local",
  "name": {
    "i18nKey": "plugins.localLauncher.name",
    "fallback": "Apps and Bookmarks Launcher"
  },
  "description": {
    "i18nKey": "plugins.localLauncher.description",
    "fallback": "Local app and browser bookmark management, plus quick-launch search results."
  },
  "category": "search",
  "enabledByDefault": true,
  "capabilities": {
    "routeNames": ["Local"],
    "settingsTabs": ["local"],
    "searchSources": ["apps", "bookmarks"]
  },
  "permissions": ["command:*"],
  "compatibleAppVersion": ">=2.1.54",
  "entry": {
    "frontend": "dist/frontend.js",
    "styles": ["dist/assets/runtime-entry-d2uKyGxX.css"]
  },
  "storage": {
    "schemaVersion": 1,
    "indexSchemaVersion": 1,
    "extractorVersion": 1
  },
  "minAppVersion": "2.1.54",
  "repository": "https://github.com/GigaPuddings/snippets-code-plugin-local-launcher",
  "releaseUrl": "https://github.com/GigaPuddings/snippets-code-plugin-local-launcher/releases/tag/2.0.32"
}

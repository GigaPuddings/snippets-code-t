# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-plugin-packages
!plugin-registry/packages/**/dist/
!plugin-registry/packages/**/dist/**
!plugin-registry/examples/**/dist/
!plugin-registry/examples/**/dist/**
target
*.local
_tmp*

# 本地环境配置；示例模板仍可提交
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# 测试报告、编译状态和工具缓存
coverage/
.nyc_output/
.cache/
.eslintcache
*.tsbuildinfo
/.superpowers/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
[Dd]esktop.ini
.cursorignore
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor

# 忽略所有以 ~ 结尾的文件和文件夹
*~
.~*
~$*

# 忽略密钥文件
*.pem
*.key
*.key.pub

# 临时发布说明文件
.release-notes.tmp
release-notes.txt
RELEASE_NOTES_TEMP.md

# 本地评审和实施过程记录；docs 仅提交长期维护的说明与规范
/docs/DAILY_RELIABILITY_*.md
/docs/PRODUCT_REVIEW_*.md
/docs/PROJECT_AUDIT_*.md
/docs/superpowers/

# RapidOCR 本地二进制和模型较大，由 pnpm rapidocr:install 下载
src-tauri/resources/rapidocr/*
!src-tauri/resources/rapidocr/README.md

# FFmpeg 本地二进制较大，由 pnpm ffmpeg:install 下载
src-tauri/resources/ffmpeg/*
!src-tauri/resources/ffmpeg/README.md

# 插件 runtime 本地资源较大，应通过独立仓库 Release asset 分发，不进入主仓库
/plugin-registry/packages/*/resources/*
!/plugin-registry/packages/*/resources/README.md
